<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily Quiz: {{ paper.title }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f0fb;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f0fb;">
<tr><td align="center" style="padding:16px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:8px;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#1f2328;">
  <tr><td style="padding:24px 24px 16px 24px;background:#fdecf3;border-radius:8px 8px 0 0;">
    <div style="font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#d6337a;">Daily research quiz · {{ today }}</div>
    <h1 style="margin:8px 0 6px 0;font-size:21px;line-height:1.3;font-weight:650;">{{ paper.title }}</h1>
    <div style="font-size:14px;line-height:1.5;color:#4a4f57;">
      {{ authors_short }}{% if paper.year %} · {{ paper.year }}{% endif %}{% if paper.venue %} · <em>{{ paper.venue }}</em>{% endif %}
    </div>
    <div style="font-size:14px;margin-top:8px;">
      {% if paper.link %}<a href="{{ paper.link }}" style="color:#1a62c4;">Open paper</a> · {% endif %}<a href="{{ paper.zotero_link }}" style="color:#1a62c4;">Show in Zotero</a>
    </div>
  </td></tr>

  <tr><td style="padding:12px 24px;">
    <div style="font-size:14px;color:#4a4f57;border-left:3px solid #f48fb8;background:#fff5f9;padding:8px 10px;">
      Answer each question in your head first. The answers and explanations are in the answer key at the bottom.
    </div>
  </td></tr>

  {% for q in quiz.questions %}
  <tr><td style="padding:14px 24px 6px 24px;">
    <div style="font-size:16px;line-height:1.5;font-weight:600;"><span style="color:#d6337a;">{{ loop.index }}.</span> {{ q.prompt }}</div>
    {% if q.options %}
    <table role="presentation" cellpadding="0" cellspacing="0" style="margin:8px 0 0 0;">
      {% for opt in q.options %}
      <tr><td style="font-size:15px;line-height:1.5;padding:2px 0;vertical-align:top;width:24px;color:#d6337a;font-weight:600;">{{ "ABCD"[loop.index0] }}.</td>
          <td style="font-size:15px;line-height:1.5;padding:2px 0;">{{ opt }}</td></tr>
      {% endfor %}
    </table>
    {% elif q.type == "true_false" %}
    <div style="font-size:13px;color:#6b6f76;margin-top:4px;">True or false?</div>
    {% else %}
    <div style="font-size:13px;color:#6b6f76;margin-top:4px;">Explain in your own words.</div>
    {% endif %}
  </td></tr>
  {% endfor %}

  <!-- Spacer so the answer key isn't visible at a glance under the last question -->
  <tr><td style="padding:28px 24px 0 24px;">
    <div style="font-size:13px;color:#d6337a;text-align:center;">Scroll down for the answer key ↓</div>
    <div style="height:260px;line-height:260px;font-size:1px;">&nbsp;</div>
    <div style="border-top:2px solid #cbb9f0;"></div>
  </td></tr>

  <tr><td style="padding:18px 24px 4px 24px;">
    <div style="font-size:18px;font-weight:650;color:#1a62c4;">Answer key</div>
  </td></tr>

  {% for q in quiz.questions %}
  <tr><td style="padding:12px 24px 6px 24px;">
    <div style="font-size:15px;line-height:1.5;font-weight:600;"><span style="color:#d6337a;">{{ loop.index }}.</span> {{ q.prompt }}</div>
    {% if q.options %}
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin:6px 0 0 0;">
      {% for opt in q.options %}
      {% set correct = loop.index0 == q.correct_index %}
      <tr><td style="font-size:14px;line-height:1.5;padding:3px 0;vertical-align:top;width:40px;color:{{ '#1f7a3d' if correct else '#c2185b' }};font-weight:600;">{{ "ABCD"[loop.index0] }}. {{ "✓" if correct else "✗" }}</td>
          <td style="font-size:14px;line-height:1.5;padding:3px 0;{{ 'background:#e3f5e6;' if correct else '' }}">
            {% if correct %}<strong>{{ opt }}</strong>{% else %}{{ opt }}{% endif %}
            {% if not correct and q.option_notes and q.option_notes[loop.index0] %}
            <div style="font-size:13px;line-height:1.45;color:#5f646b;margin-top:2px;">Why not: {{ q.option_notes[loop.index0] }}</div>
            {% endif %}
          </td></tr>
      {% endfor %}
    </table>
    {% elif q.type == "true_false" %}
    <div style="margin-top:6px;background:#e3f5e6;border-radius:6px;padding:8px 12px;font-size:14px;line-height:1.5;">
      <strong style="color:#1f7a3d;">Answer: {{ q.answer }}</strong>
    </div>
    {% else %}
    <div style="margin-top:6px;background:#e3f5e6;border-radius:6px;padding:8px 12px;font-size:14px;line-height:1.5;">
      <strong style="color:#1f7a3d;">Model answer:</strong> {{ q.answer }}
    </div>
    {% endif %}
    <div style="font-size:14px;line-height:1.5;color:#3d4249;margin-top:6px;"><strong>Explanation:</strong> {{ q.explanation }}</div>
  </td></tr>
  {% endfor %}

  <tr><td style="padding:18px 24px 24px 24px;">
    <div style="background:#fde7ef;border-radius:6px;padding:12px 14px;">
      <div style="font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#b0346a;">If you remember one thing</div>
      <div style="font-size:15px;line-height:1.5;margin-top:4px;">{{ quiz.paper_takeaway }}</div>
    </div>
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
